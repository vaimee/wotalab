{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "sosa": "http://www.w3.org/ns/sosa/",
      "qudt": "http://qudt.org/schema/qudt/",
      "unit": "http://qudt.org/vocab/unit/"
    }
  ],
  "@type": "sosa:Sensor",
  "id": "urn:dev:wot:greenhouse-environmental-sensor-01",
  "title": "Sensore Ambientale Serra",
  "description": "Nodo sensore che osserva la temperatura dell'aria e l'umidita' del suolo all'interno di una serra intelligente.",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": [
    "nosec_sc"
  ],
  "properties": {
    "temperature": {
      "@type": "sosa:ObservableProperty",
      "type": "number",
      "title": "Temperatura Ambientale",
      "description": "Temperatura dell'aria misurata all'interno della serra.",
      "qudt:unit": "unit:DEG_C",
      "minimum": 15.0,
      "maximum": 35.0,
      "readOnly": true
    },
    "humidity": {
      "@type": "sosa:ObservableProperty",
      "type": "number",
      "title": "Umidita' del Suolo",
      "description": "Contenuto di umidita' misurato nel suolo.",
      "qudt:unit": "unit:PERCENT",
      "minimum": 0.0,
      "maximum": 100.0,
      "readOnly": true
    },
    "activeGreenhouse": {
      "type": "string",
      "title": "Tipo di Serra Attivo",
      "description": "Modalita' operativa che determina la soglia di irrigazione e i parametri ambientali simulati. Property scrivibile perche' rappresenta stato di configurazione, non un processo.",
      "enum": [
        "tropical",
        "mediterranean"
      ],
      "readOnly": false
    }
  },
  "events": {
    "environmentalData": {
      "@type": "sosa:Observation",
      "title": "Telemetria Ambientale",
      "description": "Evento pubblicato periodicamente su MQTT con l'ultima osservazione di temperatura e umidita' del suolo.",
      "data": {
        "type": "object",
        "properties": {
          "temperature": {
            "@type": "sosa:ObservableProperty",
            "type": "number",
            "title": "Temperatura Ambientale",
            "qudt:unit": "unit:DEG_C"
          },
          "humidity": {
            "@type": "sosa:ObservableProperty",
            "type": "number",
            "title": "Umidita' del Suolo",
            "qudt:unit": "unit:PERCENT"
          }
        },
        "required": [
          "temperature",
          "humidity"
        ]
      },
      "forms": [
        {
          "href": "mqtt://localhost:1883/greenhouse/sensors/environmental/data",
          "op": [
            "subscribeevent"
          ],
          "contentType": "application/json"
        }
      ]
    }
  },
  "links": [
    {
      "rel": "controls",
      "href": "http://localhost:8082/pompa-irrigazione-serra",
      "type": "application/td+json"
    }
  ]
}
